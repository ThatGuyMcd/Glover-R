+    // Motion belongs to the decoded draw, never to a live guest pointer.
+    struct GloverRectMotion {
+        uint64_t identity = 0;
+        bool sky = false;
+        int32_t wrapWidth = 0;
+        std::array<int32_t, 4> rect{};
+        std::array<int32_t, 4> previous{};
+        bool matched = false;
+    };
+    inline bool matchGloverRectMotion(GloverRectMotion &cur, const GloverRectMotion &prev) {
+        cur.matched = false;
+        if (!cur.identity || cur.identity != prev.identity || cur.sky != prev.sky) return false;
+        const int cw = cur.rect[2] - cur.rect[0], ch = cur.rect[3] - cur.rect[1];
+        const int pw = prev.rect[2] - prev.rect[0], ph = prev.rect[3] - prev.rect[1];
+        if (cw <= 0 || ch <= 0 || pw <= 0 || ph <= 0) return false;
+        cur.previous = prev.rect;
+        if (cur.sky) {
+            if (cur.wrapWidth <= 0 || cur.wrapWidth != prev.wrapWidth || cw != pw || ch != ph) return false;
+            // Adjacent copies exchange places at the wrap. Follow the nearest
+            // periodic image instead of lerping across the whole sky texture.
+            const int offset = int(std::round(double(cur.rect[0] - prev.rect[0]) / cur.wrapWidth)) * cur.wrapWidth;
+            cur.previous[0] += offset;
+            cur.previous[2] += offset;
+            if (std::abs(cur.rect[0] - cur.previous[0]) > cur.wrapWidth / 4 ||
+                std::abs(cur.rect[1] - cur.previous[1]) > 240) return false;
+        }
+        else if (std::abs(cur.rect[0] - prev.rect[0]) > 640 || std::abs(cur.rect[1] - prev.rect[1]) > 480 ||
+            cw > pw * 2 || pw > cw * 2 || ch > ph * 2 || ph > ch * 2) return false;
+        cur.matched = true;
+        return true;
+    }
