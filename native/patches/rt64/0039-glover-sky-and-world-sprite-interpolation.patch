+    static void matchGloverRectangles(Workload &cur, const Workload &prev) {
+        std::unordered_map<uint64_t, std::vector<const GameCall *>> history;
+        std::unordered_map<uint64_t, unsigned> owners;
+        auto visit = [](auto &work, auto callback) {
+            for (uint32_t f = 0; f < work.fbPairCount; ++f)
+                for (uint32_t p = 0; p < work.fbPairs[f].projectionCount; ++p) {
+                    auto &proj = work.fbPairs[f].projections[p];
+                    if (proj.type != Projection::Type::Rectangle) continue;
+                    for (uint32_t c = 0; c < proj.gameCallCount; ++c) callback(proj.gameCalls[c]);
+                }
+        };
+        visit(prev, [&](const GameCall &call) {
+            if (call.callDesc.gloverRectMotion.identity) history[call.callDesc.gloverRectMotion.identity].push_back(&call);
+        });
+        visit(cur, [&](GameCall &call) {
+            auto &motion = call.callDesc.gloverRectMotion;
+            motion.matched = false;
+            if (motion.identity) ++owners[motion.identity];
+        });
+        visit(cur, [&](GameCall &call) {
+            auto &motion = call.callDesc.gloverRectMotion;
+            if (!motion.identity) return;
+            const auto found = history.find(motion.identity);
+            if (found == history.end()) return;
+            if (!motion.sky && (owners[motion.identity] != 1 || found->second.size() != 1)) return;
+            for (const auto *old : found->second) {
+                const auto &a = call.callDesc, &b = old->callDesc;
+                if (a.rectAspect != b.rectAspect || a.rectLeftOrigin != b.rectLeftOrigin || a.rectRightOrigin != b.rectRightOrigin ||
