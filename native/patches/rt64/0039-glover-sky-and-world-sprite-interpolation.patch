+                    (a.rectDsdx < 0) != (b.rectDsdx < 0) || (a.rectDtdy < 0) != (b.rectDtdy < 0)) continue;
+                bool sameMaterial = true;
+                for (uint32_t t = 0; t < a.tileCount; ++t)
+                    sameMaterial &= cur.drawData.callTiles[a.tileIndex + t].tmemHashOrID == prev.drawData.callTiles[b.tileIndex + t].tmemHashOrID;
