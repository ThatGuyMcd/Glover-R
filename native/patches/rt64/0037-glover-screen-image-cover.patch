+    // Full screen art is authored on the native canvas. Keep one transform
+    // for every strip so widening fills the screen without stretching pixels.
+    struct GloverScreenRect { float x, y, width, height; };
+    inline bool isGloverScreenImage(int width, int height, int canvasWidth, int canvasHeight) {
+        return canvasWidth > 4 && canvasHeight > 4 &&
+            width >= canvasWidth - 4 && height >= canvasHeight - 4;
+    }
+    inline GloverScreenRect gloverScreenCover(float left, float top, float right, float bottom,
+        float canvasWidth, float canvasHeight, float scaleX, float scaleY) {
+        const float scale = std::max(scaleX, scaleY);
+        const float offsetX = canvasWidth * (scaleX - scale) * 0.5f;
+        const float offsetY = canvasHeight * (scaleY - scale) * 0.5f;
+        return {left * scale + offsetX, top * scale + offsetY,
+            (right - left) * scale, (bottom - top) * scale};
+    }
     inline void setGloverSplitFrames(bool enabled) { gloverSplitFrames.store(enabled); }
     inline bool usesGloverSplitFrames() { return gloverSplitFrames.load(); }
 }
