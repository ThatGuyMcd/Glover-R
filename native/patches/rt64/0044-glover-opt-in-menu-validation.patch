+        if (!directory || frame.workloads.empty()) return;
+        const uint64_t id = queue.workloads[frame.workloads.back()].workloadId;
+        if (id == last) return;
+        last = id;
+        const std::string request = std::string(directory) + "/trace.request";
+        if (auto *trigger = std::fopen(request.c_str(), "rb")) {
+            std::fclose(trigger); std::remove(request.c_str()); remaining = 120;
+        }
+        if (!remaining) return;
+        --remaining;
+        const std::string path = std::string(directory) + "/frame-" + std::to_string(++sample) + ".txt";
+        auto *file = std::fopen(path.c_str(), "wb");
+        if (!file) return;
+        std::fprintf(file, "frame %llu target %u passes %zu matched %u\n",
+            (unsigned long long)id, target, frame.workloads.size(), unsigned(frame.matched));
+        for (unsigned w : frame.workloads) {
+            const auto &work = queue.workloads[w];
+            const auto &data = work.drawData;
+            const auto &map = frame.frameMap.workloads[w];
+            std::fprintf(file, "pass %u prev %u mapped %u vertex %u raw %u transforms %zu projections %zu\n",
+                w, map.prevWorkloadIndex, unsigned(map.mapped), data.vertexCount(), data.rawTriVertexCount(),
+                data.worldTransforms.size(), data.viewProjTransforms.size());
+            for (unsigned t = 0; t < data.worldTransforms.size(); ++t) {
+                const auto &group = data.transformGroups[data.worldTransformGroups[t]];
+                const auto &matrix = data.worldTransforms[t];
+                const auto *tm = map.mapped && t < map.transforms.size() ? &map.transforms[t] : nullptr;
+                std::fprintf(file, "model %u id %08X mapped %u prev %u pos %.5f %.5f %.5f\n", t, group.matrixId,
+                    unsigned(tm && tm->mapped), tm ? tm->prevTransformIndex : 0,
+                    float(matrix[3][0]), float(matrix[3][1]), float(matrix[3][2]));
+            }
+            for (unsigned f = 0; f < work.fbPairCount; ++f) {
+                const auto &pair = work.fbPairs[f];
+                std::fprintf(file, "fb %08X count %u\n", pair.colorImage.address, pair.gameCallCount);
+                for (unsigned p = 0; p < pair.projectionCount; ++p) {
+                    const auto &proj = pair.projections[p];
+                    const auto *vm = map.mapped && proj.transformsIndex < map.viewProjections.size() ?
+                        &map.viewProjections[proj.transformsIndex] : nullptr;
+                    std::fprintf(file, "projection %u type %u matrix %u mapped %u prev %u calls %u\n", p,
+                        unsigned(proj.type), proj.transformsIndex, unsigned(vm && vm->mapped),
+                        vm ? vm->prevTransformIndex : 0, proj.gameCallCount);
+                    for (unsigned c = 0; c < proj.gameCallCount; ++c) {
+                        const auto &call = proj.gameCalls[c].callDesc;
+                        std::fprintf(file, "call %u tris %u models %u %u id %016llX ui %u sky %u matched %u cover %u rect %d %d %d %d comb %08X %08X other %08X %08X tiles %u %u\n", c,
+                            call.triangleCount, call.minWorldMatrix, call.maxWorldMatrix,
+                            (unsigned long long)call.gloverRectMotion.identity, unsigned(call.gloverRectMotion.ui),
+                            unsigned(call.gloverRectMotion.sky), unsigned(call.gloverRectMotion.matched),
+                            unsigned(call.gloverScreenCover), call.rect.ulx, call.rect.uly, call.rect.lrx, call.rect.lry,
+                            call.colorCombiner.H, call.colorCombiner.L, call.otherMode.H, call.otherMode.L,
+                            call.tileIndex, call.tileCount);
+                    }
+                }
+            }
+        }
+        std::fclose(file);
+    }
