+    // Upload workers must not borrow vectors that another split-frame pass
+    // can resize or replace before its queued copy completes.
+    inline bool snapshotGloverUpload(const void *source, size_t count, size_t stride,
+        std::vector<uint8_t> &owned) {
+        if (!source || !count || !stride || count > std::numeric_limits<size_t>::max() / stride) {
+            owned.clear();
+            return false;
+        }
+        owned.resize(count * stride);
+        std::memcpy(owned.data(), source, owned.size());
+        return true;
+    }
     inline void setGloverSplitFrames(bool enabled) { gloverSplitFrames.store(enabled); }
     inline bool usesGloverSplitFrames() { return gloverSplitFrames.load(); }
 }
