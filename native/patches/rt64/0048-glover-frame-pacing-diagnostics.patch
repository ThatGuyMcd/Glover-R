--- /dev/null
+++ b/src/common/rt64_glover_frame_profile.h
@@ -0,0 +1,43 @@
+// Opt-in bounded frame pacing diagnostics; no GPU readbacks or guest writes.
+#pragma once
+#include <chrono>
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <string>
+namespace RT64 {
+    inline int64_t gloverProfileNow() {
+        return std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    struct GloverFrameProfile {
+        std::FILE *file = nullptr;
+        int64_t started = 0;
+        int64_t duration = 0;
+        unsigned rows = 0;
+        explicit GloverFrameProfile(const char *name, const char *columns) {
+            const char *directory = std::getenv("GLOVER_FRAME_PROFILE");
+            if (!directory || !*directory) return;
+            const char *seconds = std::getenv("GLOVER_FRAME_PROFILE_SECONDS");
+            duration = 1000000LL * (seconds ? std::max(1, std::min(300, std::atoi(seconds))) : 90);
+            file = std::fopen((std::string(directory) + "/" + name + ".csv").c_str(), "wb");
+            if (file) {
+                std::fprintf(file, "%s\n", columns);
+                started = gloverProfileNow();
+            }
+        }
+        bool active() {
+            if (file && gloverProfileNow() - started > duration) {
+                std::fclose(file); file = nullptr;
+            }
+            return file != nullptr;
+        }
+        template<class... Args> void row(const char *format, Args... args) {
+            if (!active()) return;
+            std::fprintf(file,format,args...);
+            if (++rows % 128 == 0) std::fflush(file);
+        }
+        ~GloverFrameProfile() { if (file) std::fclose(file); }
+    };
+}
